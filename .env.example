ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080

# Postgres local de docker-compose (puerto 5433 en el host). En Supabase:
# host/puerto del proyecto, DATABASE_SSLMODE=require y DATABASE_SCHEMA=admin.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=discordia_admin
DATABASE_USER=discordia
DATABASE_PASSWORD=discordia
DATABASE_SSLMODE=disable
DATABASE_SCHEMA=

# Mismo secreto que usa identify para firmar los JWT (HS256).
# Generar uno para desarrollo: openssl rand -hex 32
JWT_SECRET=

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Firma de los eventos admin.* (compartido con los servicios que los consumen).
# Generar uno para desarrollo: openssl rand -hex 32
ADMIN_EVENTS_HMAC_SECRET=

# Usuarios (UUID de identify) que se siembran como staff al arrancar, separados por coma.
STAFF_USER_IDS=

# Cada cuánto el outbox publica los eventos pendientes (ej. 2s).
OUTBOX_POLL_INTERVAL=2s
